# No trailing slash, deliberately: `node_modules/` matches a DIRECTORY only, and a
# worktree that reaches the shared install through a symlink puts a non-directory of
# that name at the root. One got committed that way.
node_modules
.next/
next-env.d.ts

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Git worktrees created by tooling under .claude/ — never part of the tree
.claude/worktrees/
